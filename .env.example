# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
DEFAULT_MODEL=claude-sonnet-4-5-20250929
DEFAULT_MAX_TOKENS=4096
DEFAULT_TEMPERATURE=0.7

# System Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Workflow Configuration
COMPLETENESS_THRESHOLD=80
CONFIDENCE_THRESHOLD=70
ENABLE_HUMAN_REVIEW=true

# Output Configuration
OUTPUT_DIR=./outputs
REPORTS_DIR=./reports
MODELS_DIR=./models

# API Configuration (if using FastAPI)
API_HOST=0.0.0.0
API_PORT=8000

# Gmail & Google Forms Integration (Optional)
# See INTEGRATION_SETUP.md for setup instructions
# GMAIL_CHECK_INTERVAL=300
# GMAIL_MAX_RESULTS=10
# GMAIL_WATCH_LABEL=INBOX
# MAX_FOLLOW_UP_ROUNDS=3
# FOLLOW_UP_RESPONSE_TIMEOUT_HOURS=48
# GOOGLE_FORM_ID=your_form_id_here
